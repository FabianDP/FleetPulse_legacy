# Local demonstration only. Generate fresh credentials: node scripts/setup-env.cjs
# Template values are empty; the generated .env contains local credentials. Never commit it.
# Backend uses DB_* (DATABASE_URL is not consumed).
DB_HOST=127.0.0.1
DB_PORT=5434
DB_USER=fleetpulse_demo
DB_NAME=fleetpulse_demo
DB_PASSWORD=
# Angular currently uses localhost:3000; keep this port for the documented demo.
PORT=3000
API_KEY=
REPLAY_ENABLED=true
# Independent password for browser login; username: replay.
REPLAY_PASSWORD=
